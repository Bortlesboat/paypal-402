# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave empty to run against the built-in mock PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default with creds) | mock | live
PAYPAL_MODE=
# Required with real creds: HMAC key that binds 402 offers to routes and prices.
MERCHANT_SECRET=
# Optional: PayPal merchant id the merchant expects as payee.
PAYPAL_PAYEE_MERCHANT_ID=

# AI provider: first one set wins. With none set, a scripted (non-AI) planner runs the same flow.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Ports and keys
PORT=4020
MERCHANT_PORT=4021
AGENT_KEY=local-agent-key
# PUBLIC_URL=http://localhost:4020   # set when PayPal must redirect to a non-localhost URL
# MEMPOOL_API=https://mempool.space/api
# MEMPOOL_OFFLINE=1                  # use bundled sample data instead of mempool.space
